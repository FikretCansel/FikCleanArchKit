{
  "name": "fik-stack",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",

    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",

    "dev:backend": "cd apps/backend && mvnw spring-boot:run",

    "dev:all": "npx npm-run-all --parallel dev:web dev:mobile dev:backend",

    "build": "npm run build --workspaces",

    "clean": "rm -rf node_modules apps/**/node_modules packages/**/node_modules .next"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}